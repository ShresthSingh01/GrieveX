# -----------------------------------------------------------------------------
# ResolveGraph Environment Configuration Example
# Copy this file to .env and set your values before running the application.
# -----------------------------------------------------------------------------

# Google Gemini API Key (Optional)
# If provided, enables LLM-driven structured extraction and reasoning.
# If omitted, the engine automatically falls back to deterministic rule-based parsing.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Database URL (Optional)
# Defaults to local SQLite database at ./resolvegraph/data/resolvegraph.db
# For production PostgreSQL / Supabase, use: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./resolvegraph/data/resolvegraph.db

# Frontend Public API Base URL (Used by Next.js web app)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
