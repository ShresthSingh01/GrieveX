# -----------------------------------------------------------------------------
# ResolveGraph / GrieveX Production Configuration
# -----------------------------------------------------------------------------

# Application Execution Mode: production | development | test
# In production, seed endpoints are disabled and live AI failure fails fast.
APP_MODE=development

# AI Mode: live | offline
# - live: invokes real Google Gemini LLM API (requires GEMINI_API_KEY)
# - offline: runs 0-token deterministic semantic rule engine (conserves free API quota)
AI_MODE=offline

# Google Gemini API Key (Required when AI_MODE=live)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Database URL
# Local dev: sqlite:///./resolvegraph/data/resolvegraph.db
# Production (Render / Supabase / PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./resolvegraph/data/resolvegraph.db

# Allowed CORS Origins (Comma-separated)
# Automatically matches https://*.vercel.app by default in FastAPI
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Public API Base URL (Used by Next.js web app)
# Local: http://localhost:8000/api
# Production on Vercel: https://your-backend-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
